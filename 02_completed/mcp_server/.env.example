# Azure Cosmos DB Configuration
COSMOSDB_ENDPOINT=
# agent_memory_toolkit reads COSMOSDB_DATABASE_NAME; the workshop app also reads COSMOS_DB_DATABASE_NAME.
COSMOSDB_DATABASE_NAME=TravelAssistant
COSMOS_DB_DATABASE_NAME=TravelAssistant
COSMOS_KEY=

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=
# Chat deployment used by the workshop agents.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Embedding deployment used by agent_memory_toolkit and place vector search.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_API_KEY=

# Agent Memory Toolkit auto-summarization thresholds.
# Set to 1 to consolidate user_summary after every turn (perf spec §5.3)
THREAD_SUMMARY_EVERY_N=1
USER_SUMMARY_EVERY_N=1

# MCP Server Configuration
MCP_SERVER_BASE_URL=http://localhost:8080
MCP_AUTH_TOKEN=banking-server-dev-token-2024
MCP_AUTH_SECRET_KEY="banking-mcp-server-jwt-secret-for-local-development"
PORT=8080
USE_REMOTE_MCP_SERVER="true"

# Optional: GitHub OAuth (Production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LangSmith (Optional - for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=travel-assistant
